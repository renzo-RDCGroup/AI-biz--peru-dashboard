<div class="ps" data-terms="{{ predictive_search.terms }}" data-performed="{{ predictive_search.performed }}">{% for p in predictive_search.resources.products %}<a class="ps-p" href="{{ p.url }}">{{ p.title }}</a>{% endfor %}{% for q in predictive_search.resources.queries %}<a class="ps-q" href="{{ q.url }}">{{ q.styled_text }}</a>{% endfor %}{% for c in predictive_search.resources.collections %}<a class="ps-c">{{ c.title }}</a>{% endfor %}</div>
