{%- comment -%}
  Password page (layout/password.liquid: no header/footer, no JS). Full-screen brand yellow,
  echoing the brand manual cover: "mi" mark, huge heading with the red dot, a newsletter form
  ({% form 'customer' %}, tagged) and the storefront password form inside a <details> in the
  top bar (opens automatically when the password was wrong).
  Styles are inline on purpose: they are only ever needed on this page.
{%- endcomment -%}
{{ 'section-pages.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ss = section.settings
  assign wm_tone = 'mono-dark'
  assign logo_tone = 'dark'
  if ss.scheme == 'dark'
    assign wm_tone = 'mono-light'
    assign logo_tone = 'light'
  endif
  assign intro = shop.password_message | default: ss.text
  assign year = 'now' | date: '%Y'
  assign title_dot = true
  assign title_last = ss.heading | strip | slice: -1
  if title_last == '.' or title_last == '?' or title_last == '!' or title_last == ':' or title_last == '…'
    assign title_dot = false
  endif
-%}

<style>
  .password { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto 1fr auto; min-height: 100vh; min-height: 100dvh; }
  .password__top { position: relative; z-index: 3; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-block: 16px; }
  .password__brand { width: 124px; }
  .password__login { position: relative; }
  .password__login > summary { list-style: none; white-space: nowrap; }
  .password__login-long { display: none; }
  @media (min-width: 480px) { .password__login-long { display: inline; } .password__login-short { display: none; } }
  .password__login > summary::-webkit-details-marker { display: none; }
  .password__login[open] > summary { background: var(--scheme-fg); color: var(--scheme-bg); }
  .password__panel { position: absolute; top: calc(100% + 10px); right: 0; width: min(360px, calc(100vw - 2 * var(--gutter))); padding: 20px; border-radius: var(--radius-lg); background: #fff; color: var(--color-ink); box-shadow: var(--shadow-lg); }
  .password__panel .field { gap: 8px; }
  .password__row { display: flex; gap: 8px; }
  .password__row .input { flex: 1; min-width: 0; }
  .password__panel .form-message { margin-top: 12px; }
  .password__main { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 18px; padding-block: 32px 48px; }
  .password__mark { width: 88px; margin-bottom: 8px; }
  .password__title { max-width: 12ch; }
  .password__text { max-width: 46ch; color: var(--scheme-muted); font-size: var(--fs-md); }
  .password__signup { width: 100%; max-width: 520px; margin-top: 6px; }
  .password__signup .pill-search { border-color: transparent; box-shadow: var(--shadow-md); }
  .password__signup .form-message { margin-top: 12px; }
  .password__foot { position: relative; z-index: 2; display: flex; flex-wrap: wrap; gap: 6px 20px; padding-block: 20px 24px; background: linear-gradient(var(--scheme-border), var(--scheme-border)) top center / calc(100% - 2 * var(--gutter)) 1px no-repeat; color: var(--scheme-muted); font-size: var(--fs-xs); }
  .password__foot a { color: var(--scheme-fg); font-weight: 700; }
  .password .mi-watermark { width: min(92vw, 820px); right: -18%; bottom: -8%; }
  @media (min-width: 750px) {
    .password__brand { width: 160px; }
    .password__top { padding-block: 24px; }
    .password__mark { width: 128px; }
    .password__foot { justify-content: space-between; }
    .password__title { max-width: 16ch; }
    .password .mi-watermark { right: -8%; bottom: -14%; }
  }
</style>

<div class="password scheme-{{ ss.scheme }} has-watermark">
  <div class="password__top page-width">
    <span class="password__brand">{% render 'logo', tone: logo_tone %}</span>

    {%- form 'storefront_password', class: 'password__login-form' -%}
      <details class="password__login"{% if form.errors %} open{% endif %}>
        <summary class="btn btn--sm btn--outline">
          {%- render 'icon', name: 'lock' -%}
          <span class="password__login-long">{{ 'password.login.summary' | t }}</span>
          <span class="password__login-short">{{ 'password.login.summary_short' | t }}</span>
        </summary>
        <div class="password__panel">
          <div class="field">
            <label class="field__label" for="PasswordInput-{{ section.id }}">{{ 'password.login.label' | t }}</label>
            <div class="password__row">
              <input class="input" type="password" id="PasswordInput-{{ section.id }}" name="password" autocomplete="current-password" required aria-required="true"{% if form.errors %} aria-invalid="true" aria-describedby="PasswordError-{{ section.id }}"{% endif %}>
              <button class="btn btn--primary" type="submit">{{ 'password.login.submit' | t }}</button>
            </div>
          </div>
          {%- if form.errors -%}
            <p class="form-message form-message--error" id="PasswordError-{{ section.id }}" role="alert">{{ 'password.login.error' | t }}</p>
          {%- endif -%}
        </div>
      </details>
    {%- endform -%}
  </div>

  <div class="password__main page-width">
    <span class="password__mark">{% render 'logo', variant: 'mark', tone: logo_tone, label: '' %}</span>
    {%- if ss.eyebrow != blank -%}
      <p class="eyebrow eyebrow--dot">{{ ss.eyebrow | escape }}</p>
    {%- endif -%}
    <h1 class="password__title display{% if title_dot %} heading-dot{% endif %}">{{ ss.heading | escape }}</h1>
    {%- if intro != blank -%}
      <div class="password__text">{{ intro }}</div>
    {%- endif -%}

    {%- if ss.show_newsletter -%}
      {%- form 'customer', id: 'PasswordSignup', class: 'password__signup' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, password-page">
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" role="status">{{ 'password.newsletter.success' | t }}</p>
        {%- else -%}
          <div class="pill-search">
            <label class="visually-hidden" for="PasswordSignupEmail-{{ section.id }}">{{ 'password.newsletter.label' | t }}</label>
            <span class="pill-search__icon" aria-hidden="true">{% render 'icon', name: 'mail' %}</span>
            <input class="pill-search__input" type="email" id="PasswordSignupEmail-{{ section.id }}" name="contact[email]" placeholder="{{ 'password.newsletter.placeholder' | t }}" autocomplete="email" autocapitalize="off" spellcheck="false" required aria-required="true"{% if form.errors %} aria-invalid="true" aria-describedby="PasswordSignupError-{{ section.id }}"{% endif %}>
            <button class="btn btn--primary pill-search__btn" type="submit">{{ 'password.newsletter.submit' | t }}</button>
          </div>
          {%- if form.errors -%}
            <p class="form-message form-message--error" id="PasswordSignupError-{{ section.id }}" role="alert">
              {{- 'password.newsletter.error_heading' | t }} {{ form.errors.translated_fields.email | default: 'email' }} {{ form.errors.messages.email -}}
            </p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}

    {%- render 'social-icons', class: 'password__social' -%}
  </div>

  <div class="password__foot page-width">
    <p>{{ 'footer.copyright' | t: year: year, shop: shop.name }}</p>
    <p>{{ 'password.admin_link_html' | t }}</p>
  </div>

  {%- render 'logo', variant: 'mark', tone: wm_tone, label: '', class: 'mi-watermark' -%}
</div>

{% schema %}
{
  "name": "Página con contraseña",
  "class": "password-section",
  "settings": [
    {"type": "select", "id": "scheme", "label": "Esquema de color", "options": [{"value": "light", "label": "Claro"}, {"value": "soft", "label": "Gris suave"}, {"value": "brand", "label": "Amarillo"}, {"value": "dark", "label": "Oscuro"}], "default": "brand"},
    {"type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Muy pronto"},
    {"type": "text", "id": "heading", "label": "Título", "default": "Estamos preparando algo"},
    {"type": "richtext", "id": "text", "label": "Texto", "info": "Si escribes un mensaje en Preferencias › Protección con contraseña, se muestra ese mensaje en su lugar.", "default": "<p>Accesorios y repuestos para bicicleta y scooter. Déjanos tu correo y te avisamos cuando abramos.</p>"},
    {"type": "checkbox", "id": "show_newsletter", "label": "Mostrar formulario de correo", "default": true}
  ]
}
{% endschema %}
