{%- comment -%}
  Footer (footer group). Dark by default.
  Top: brand statement (tagline/text), social icons, WhatsApp card (only with a number)
  · link columns from blocks (menu / text / contact). Then an optional edge-to-edge logo
  lockup and the bottom bar (© year shop · policies · payment icons).
  Mobile (<750): every column is a <details> accordion. The columns are server-rendered
  open (so they work without JS); <footer-menus> collapses them on phones and keeps them open
  from 750px up, where CSS hides the <summary> and shows a plain h2 instead (no inert
  disclosure button for screen readers). Exactly one of the two h2s is rendered per width.
{%- endcomment -%}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign fs = section.settings
  assign wa_digits = settings.whatsapp_number | strip | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')' | remove: '.'
  assign logo_tone = 'dark'
  if fs.scheme == 'dark'
    assign logo_tone = 'light'
  endif
  assign heading_dot = true
  assign heading_last = fs.heading | strip | slice: -1
  if heading_last == '.' or heading_last == '?' or heading_last == '!' or heading_last == ':' or heading_last == '…'
    assign heading_dot = false
  endif
  assign year = 'now' | date: '%Y'
  assign has_float = false
  if settings.whatsapp_float and wa_digits != blank
    assign has_float = true
  endif
-%}

<footer class="footer section scheme-{{ fs.scheme }}{% if has_float %} footer--float{% endif %}" style="--pad-top: {{ fs.padding_top }}px; --pad-bottom: {{ fs.padding_bottom }}px;">
  <div class="page-width">
    <div class="footer__main{% if section.blocks.size == 0 %} footer__main--solo{% endif %}">
      <div class="footer__brand">
        {%- unless fs.big_logo -%}
          <a class="footer__logo" href="{{ routes.root_url }}">
            {%- if fs.logo != blank -%}
              {{- fs.logo | image_url: width: 480 | image_tag: widths: '240,360,480', sizes: '200px', alt: shop.name, loading: 'lazy', class: 'footer__logo-img' -}}
            {%- else -%}
              {%- render 'logo', tone: logo_tone -%}
            {%- endif -%}
          </a>
        {%- endunless -%}

        {%- if fs.heading != blank -%}
          <p class="footer__heading{% if heading_dot %} heading-dot{% endif %}">{{ fs.heading | escape }}</p>
        {%- endif -%}
        {%- if fs.text != blank -%}
          <div class="footer__text{% if fs.heading == blank %} footer__text--lead{% endif %}">{{ fs.text }}</div>
        {%- endif -%}

        {%- if fs.show_social -%}
          {%- render 'social-icons', class: 'footer__social' -%}
        {%- endif -%}

        {%- if fs.show_whatsapp and wa_digits != blank -%}
          {%- render 'whatsapp-button', style: 'card', label: fs.whatsapp_label, text: fs.whatsapp_text, class: 'footer__wa' -%}
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <footer-menus class="footer__cols">
          {%- for block in section.blocks -%}
            {%- liquid
              assign bs = block.settings
              assign col_title = bs.heading
              assign show_col = true
              case block.type
                when 'menu'
                  if bs.menu == blank or bs.menu.links.size == 0
                    assign show_col = false
                  endif
                  if col_title == blank and bs.menu != blank
                    assign col_title = bs.menu.title
                  endif
                when 'text'
                  if bs.text == blank
                    assign show_col = false
                  endif
                when 'contact'
                  assign has_wa = false
                  if bs.show_whatsapp and wa_digits != blank
                    assign has_wa = true
                  endif
                  if has_wa == false and settings.contact_phone == blank and settings.contact_email == blank and settings.contact_address == blank and settings.contact_hours == blank
                    assign show_col = false
                  endif
              endcase
            -%}
            {%- if show_col -%}
              <div class="footer__col footer__col--{{ block.type }}" {{ block.shopify_attributes }}>
                <h2 class="footer__col-title footer__col-title--wide">{{ col_title | escape }}</h2>
                <details class="footer__details" open>
                  <summary class="footer__summary">
                    <h2 class="footer__col-title">{{ col_title | escape }}</h2>
                    {%- render 'icon', name: 'chevron-down', class: 'footer__chevron' -%}
                  </summary>
                  <div class="footer__panel">
                    {%- case block.type -%}
                      {%- when 'menu' -%}
                        <ul class="footer__links" role="list">
                          {%- for link in bs.menu.links -%}
                            <li><a class="footer__link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
                            {%- if bs.show_children -%}
                              {%- for child in link.links -%}
                                <li><a class="footer__link footer__link--child" href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a></li>
                              {%- endfor -%}
                            {%- endif -%}
                          {%- endfor -%}
                        </ul>
                      {%- when 'text' -%}
                        <div class="footer__rte rte">{{ bs.text }}</div>
                      {%- when 'contact' -%}
                        <ul class="footer__contact" role="list">
                          {%- if has_wa -%}
                            <li class="footer__contact-item">{% render 'whatsapp-button', style: 'link', label: bs.whatsapp_label, class: 'footer__wa-link' %}</li>
                          {%- endif -%}
                          {%- if settings.contact_phone != blank -%}
                            {%- assign tel = settings.contact_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.' -%}
                            <li class="footer__contact-item">
                              {%- render 'icon', name: 'phone' -%}
                              <span class="visually-hidden">{{ 'footer.contact.phone' | t }}:</span>
                              <a href="tel:{{ tel | escape }}">{{ settings.contact_phone | escape }}</a>
                            </li>
                          {%- endif -%}
                          {%- if settings.contact_email != blank -%}
                            <li class="footer__contact-item">
                              {%- render 'icon', name: 'mail' -%}
                              <span class="visually-hidden">{{ 'footer.contact.email' | t }}:</span>
                              <a href="mailto:{{ settings.contact_email | strip | escape }}">{{ settings.contact_email | escape }}</a>
                            </li>
                          {%- endif -%}
                          {%- if settings.contact_address != blank -%}
                            <li class="footer__contact-item">
                              {%- render 'icon', name: 'map-pin' -%}
                              <span class="visually-hidden">{{ 'footer.contact.address' | t }}:</span>
                              <span>{{ settings.contact_address | escape }}</span>
                            </li>
                          {%- endif -%}
                          {%- if settings.contact_hours != blank -%}
                            <li class="footer__contact-item">
                              {%- render 'icon', name: 'clock' -%}
                              <span class="visually-hidden">{{ 'footer.contact.hours' | t }}:</span>
                              <span>{{ settings.contact_hours | escape }}</span>
                            </li>
                          {%- endif -%}
                        </ul>
                    {%- endcase -%}
                  </div>
                </details>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </footer-menus>
        <script>
          (function () {
            if (customElements.get('footer-menus')) return;
            /* Phones: collapsed accordions. >=750px: always open (CSS hides the summaries). */
            class FooterMenus extends HTMLElement {
              connectedCallback() {
                this.mq = window.matchMedia('(min-width: 750px)');
                this.sync = () => {
                  const wide = this.mq.matches;
                  this.querySelectorAll('.footer__details').forEach((d) => { d.open = wide; });
                };
                this.mq.addEventListener('change', this.sync);
                this.sync();
              }
              disconnectedCallback() {
                if (this.mq) this.mq.removeEventListener('change', this.sync);
              }
            }
            customElements.define('footer-menus', FooterMenus);
          })();
        </script>
      {%- endif -%}
    </div>

    {%- if fs.big_logo -%}
      <a class="footer__biglogo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        {%- if fs.logo != blank -%}
          {{- fs.logo | image_url: width: 2000 | image_tag: widths: '600,900,1320,2000', sizes: '(min-width: 1400px) 1320px, 100vw', alt: '', loading: 'lazy', class: 'footer__logo-img' -}}
        {%- else -%}
          {%- render 'logo', tone: logo_tone, label: '' -%}
        {%- endif -%}
      </a>
    {%- endif -%}

    <div class="footer__bottom">
      <p class="footer__copy">{{ 'footer.copyright' | t: year: year, shop: shop.name }}</p>
      {%- if fs.show_policies and shop.policies.size > 0 -%}
        <nav class="footer__policies-nav" aria-label="{{ 'footer.policies' | t }}">
          <ul class="footer__policies" role="list">
            {%- for policy in shop.policies -%}
              <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
      {%- if fs.show_payment -%}
        {%- render 'payment-icons', class: 'footer__payment' -%}
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pie de página",
  "class": "footer-section",
  "enabled_on": { "groups": ["footer"] },
  "max_blocks": 5,
  "settings": [
    {"type": "select", "id": "scheme", "label": "Esquema de color", "options": [{"value": "light", "label": "Claro"}, {"value": "soft", "label": "Gris suave"}, {"value": "brand", "label": "Amarillo"}, {"value": "dark", "label": "Oscuro"}], "default": "dark"},
    {"type": "header", "content": "Marca"},
    {"type": "checkbox", "id": "big_logo", "label": "Logo grande al final", "info": "Muestra el logo a todo el ancho antes de la barra inferior. Si lo desactivas, el logo aparece pequeño arriba.", "default": true},
    {"type": "image_picker", "id": "logo", "label": "Logo alternativo (opcional)", "info": "Vacío = logo vectorial de la marca, con el tono correcto para el fondo."},
    {"type": "text", "id": "heading", "label": "Frase destacada (opcional)"},
    {"type": "richtext", "id": "text", "label": "Texto", "default": "<p>Accesorios y repuestos para bicicleta y scooter. Seguridad, confort y estilo en cada trayecto.</p>"},
    {"type": "checkbox", "id": "show_social", "label": "Mostrar redes sociales", "info": "Se configuran en Configuración del tema › Redes sociales.", "default": true},
    {"type": "checkbox", "id": "show_whatsapp", "label": "Mostrar tarjeta de WhatsApp", "info": "Solo aparece si hay un número en Configuración del tema › Contacto.", "default": true},
    {"type": "text", "id": "whatsapp_label", "label": "Título de la tarjeta", "default": "¿Dudas con un repuesto?", "visible_if": "{{ section.settings.show_whatsapp }}"},
    {"type": "text", "id": "whatsapp_text", "label": "Texto de la tarjeta", "default": "Escríbenos con una foto", "visible_if": "{{ section.settings.show_whatsapp }}"},
    {"type": "header", "content": "Barra inferior"},
    {"type": "checkbox", "id": "show_policies", "label": "Mostrar políticas", "default": true},
    {"type": "checkbox", "id": "show_payment", "label": "Mostrar métodos de pago", "default": true},
    {"type": "header", "content": "Espaciado"},
    {"type": "range", "id": "padding_top", "label": "Margen superior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64},
    {"type": "range", "id": "padding_bottom", "label": "Margen inferior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28}
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menú",
      "settings": [
        {"type": "text", "id": "heading", "label": "Título", "default": "Categorías"},
        {"type": "link_list", "id": "menu", "label": "Menú", "default": "main-menu"},
        {"type": "checkbox", "id": "show_children", "label": "Incluir subenlaces", "default": false}
      ]
    },
    {
      "type": "text",
      "name": "Texto",
      "settings": [
        {"type": "text", "id": "heading", "label": "Título", "default": "Mi Bicicleta"},
        {"type": "richtext", "id": "text", "label": "Texto", "default": "<p>Accesorios y repuestos para bicicleta y scooter.</p>"}
      ]
    },
    {
      "type": "contact",
      "name": "Contacto",
      "limit": 1,
      "settings": [
        {"type": "paragraph", "content": "Muestra solo los datos que completes en Configuración del tema › Contacto (WhatsApp, teléfono, correo, dirección y horario). Si todos están vacíos, la columna no aparece."},
        {"type": "text", "id": "heading", "label": "Título", "default": "Contacto"},
        {"type": "checkbox", "id": "show_whatsapp", "label": "Incluir WhatsApp", "default": true},
        {"type": "text", "id": "whatsapp_label", "label": "Texto del enlace de WhatsApp", "default": "Escríbenos por WhatsApp", "visible_if": "{{ block.settings.show_whatsapp }}"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Pie de página",
      "blocks": [
        {"type": "menu", "settings": {"heading": "Categorías", "menu": "main-menu"}},
        {"type": "menu", "settings": {"heading": "Ayuda", "menu": "footer"}},
        {"type": "contact"}
      ]
    }
  ]
}
{% endschema %}
