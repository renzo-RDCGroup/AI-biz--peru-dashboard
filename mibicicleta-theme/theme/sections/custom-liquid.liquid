{%- comment -%}
  Custom Liquid: lets the merchant paste Liquid/HTML (embeds, app snippets, tracking widgets)
  anywhere, wrapped in the theme's scheme + spacing so it sits in the page rhythm.
  While empty it renders nothing on the storefront; in the theme editor it shows a dashed
  placeholder so the new section has a visible area to click.
{%- endcomment -%}
{%- liquid
  assign ss = section.settings
  assign wrap_class = 'page-width'
  if ss.full_width
    assign wrap_class = 'custom-liquid__full'
  endif
-%}
{%- if ss.custom_liquid != blank -%}
  <div class="section custom-liquid scheme-{{ ss.scheme }}" style="--pad-top: {{ ss.padding_top }}px; --pad-bottom: {{ ss.padding_bottom }}px;">
    <div class="{{ wrap_class }}">
      {{ ss.custom_liquid }}
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="section custom-liquid scheme-{{ ss.scheme }}" style="--pad-top: {{ ss.padding_top }}px; --pad-bottom: {{ ss.padding_bottom }}px;">
    <div class="page-width">
      <p class="custom-liquid__empty" style="padding: 32px 20px; border: 2px dashed var(--scheme-border); border-radius: var(--radius); color: var(--scheme-muted); font-size: var(--fs-sm); text-align: center;">{{ 'pages.custom_liquid.empty' | t }}</p>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Liquid personalizado",
  "tag": "section",
  "class": "custom-liquid-section",
  "settings": [
    {"type": "liquid", "id": "custom_liquid", "label": "Código Liquid", "info": "Pega aquí fragmentos de apps u otro código Liquid/HTML."},
    {"type": "select", "id": "scheme", "label": "Esquema de color", "options": [{"value": "light", "label": "Claro"}, {"value": "soft", "label": "Gris suave"}, {"value": "brand", "label": "Amarillo"}, {"value": "dark", "label": "Oscuro"}], "default": "light"},
    {"type": "checkbox", "id": "full_width", "label": "Ancho completo (sin márgenes laterales)", "default": false},
    {"type": "header", "content": "Espaciado"},
    {"type": "range", "id": "padding_top", "label": "Margen superior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40},
    {"type": "range", "id": "padding_bottom", "label": "Margen inferior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40}
  ],
  "presets": [
    {"name": "Liquid personalizado"}
  ]
}
{% endschema %}
