{%- comment -%}
  Product recommendations (related | complementary; product template only). The product page
  renders an empty <product-recommendations> shell; the section script below fetches
  {{ routes.product_recommendations_url }}?section_id=…&product_id=…&limit=…&intent=…
  once the page is idle and swaps in the carousel. That response is built only from the
  documented `recommendations` object (`product` may not exist there). Nothing shows when
  Shopify has no recommendations (complementary needs the Search & Discovery app).
{%- endcomment -%}
{%- liquid
  assign rec_url = ''
  if product != blank
    assign rec_url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product.id | append: '&limit=' | append: section.settings.limit | append: '&intent=' | append: section.settings.intent
  endif
  assign heading_id = 'Recs-' | append: section.id
-%}
{%- if rec_url != '' or recommendations.performed? -%}
  <product-recommendations class="product-recs scheme-{{ section.settings.scheme }}"{% if rec_url != '' %} data-url="{{ rec_url }}"{% endif %}>
    {%- if recommendations.performed? and recommendations.products_count > 0 -%}
      <div class="section" style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;">
        <div class="page-width">
          <carousel-slider
            class="carousel carousel--bleed product-recs__carousel{% if section.settings.columns_desktop == '5' %} product-recs__carousel--5{% endif %}"
            aria-labelledby="{{ heading_id }}"
          >
            <div class="product-recs__head">
              {%- render 'section-heading', title: section.settings.heading, id: heading_id, dot: section.settings.heading_dot -%}
              <div class="product-recs__arrows">
                <button type="button" class="btn btn--icon btn--outline carousel__prev" aria-label="{{ 'general.carousel.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
                <button type="button" class="btn btn--icon btn--outline carousel__next" aria-label="{{ 'general.carousel.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
              </div>
            </div>
            <ul class="carousel__track" role="list">
              {%- for rec in recommendations.products -%}
                <li class="carousel__slide">
                  {%- render 'product-card', product: rec, section_id: section.id, lazy: true -%}
                </li>
              {%- endfor -%}
            </ul>
            <div class="carousel__controls product-recs__dots"><div class="carousel__dots"></div></div>
          </carousel-slider>
        </div>
      </div>
    {%- endif -%}
  </product-recommendations>
{%- endif -%}

{% stylesheet %}
  .product-recs { display: block; }
  .product-recs__carousel { --per-view: 2.15; --gap: 12px; }
  .product-recs__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px 24px; margin-bottom: 24px; }
  .product-recs__head .section-heading { flex: 1 1 auto; margin-bottom: 0; }
  .product-recs__arrows { display: flex; gap: 8px; }
  @media (max-width: 749.98px) {
    .product-recs__arrows { display: none; }
  }
  @media (min-width: 750px) {
    .product-recs__carousel { --per-view: 3; --gap: 24px; }
    .product-recs__head { margin-bottom: 32px; }
    .product-recs__dots { display: none; }
  }
  @media (min-width: 990px) {
    .product-recs__carousel { --per-view: 4; }
  }
  @media (min-width: 1200px) {
    .product-recs__carousel--5 { --per-view: 5; }
  }
{% endstylesheet %}

{% javascript %}
  /* <product-recommendations>: loads this section from the recommendations endpoint once the
     page is idle (after `load`), so the carousel is in place before the shopper scrolls to it
     (no late layout shift of the USP strip / footer); stays hidden when Shopify returns no
     products. Boots on DOMContentLoaded: compiled section JS may run before global.js. */
  (function () {
    function boot() {
      if (!window.customElements || customElements.get('product-recommendations')) return;
      class ProductRecommendations extends HTMLElement {
        connectedCallback() {
          if (this._ready || !this.dataset.url) return;
          this._ready = true;
          if (this.querySelector('.product-card')) return;
          const load = () => {
            fetch(this.dataset.url, { credentials: 'same-origin' })
              .then((r) => (r.ok ? r.text() : ''))
              .then((html) => {
                const fresh = html ? new DOMParser().parseFromString(html, 'text/html').querySelector('product-recommendations') : null;
                if (fresh && fresh.querySelector('.product-card')) this.innerHTML = fresh.innerHTML;
                else this.hidden = true;
              })
              .catch(() => { this.hidden = true; });
          };
          const idle = window.requestIdleCallback || ((cb) => setTimeout(cb, 200));
          const kick = () => idle(load, { timeout: 2000 });
          if (document.readyState === 'complete') kick();
          else window.addEventListener('load', kick, { once: true });
        }
      }
      customElements.define('product-recommendations', ProductRecommendations);
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Recomendaciones",
  "class": "product-recs-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Recomendaciones automáticas de Shopify. «Complementarios» se configura en la app Search & Discovery; si no hay productos, la sección no se muestra."
    },
    {
      "type": "select",
      "id": "intent",
      "label": "Tipo",
      "options": [
        { "value": "related", "label": "Relacionados" },
        { "value": "complementary", "label": "Complementarios" }
      ],
      "default": "related"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Esquema de color",
      "options": [
        { "value": "light", "label": "Claro" },
        { "value": "soft", "label": "Gris suave" },
        { "value": "brand", "label": "Amarillo" },
        { "value": "dark", "label": "Oscuro" }
      ],
      "default": "light"
    },
    { "type": "text", "id": "heading", "label": "Título", "default": "También te puede servir" },
    { "type": "checkbox", "id": "heading_dot", "label": "Punto rojo en el título", "info": "Requiere «Punto rojo al final de los títulos» en Configuración del tema › Tipografía.", "default": true },
    { "type": "range", "id": "limit", "label": "Máximo de productos", "min": 2, "max": 10, "step": 1, "default": 8 },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Productos visibles en escritorio",
      "options": [
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "4"
    },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Margen superior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Margen inferior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [
    { "name": "Recomendaciones" }
  ]
}
{% endschema %}
