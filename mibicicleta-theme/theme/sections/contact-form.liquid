{%- comment -%}
  Contact form ({% form 'contact' %}: name, email, phone, message) in a soft card, with an
  optional aside built from blocks: WhatsApp card (only with a number), contact details (only
  the contact_* theme settings that are filled) and highlight rows (icon + verified copy).
  Success replaces the fields with a confirmation panel; errors list the fields with links.
{%- endcomment -%}
{{ 'section-pages.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ss = section.settings
  assign wa_digits = settings.whatsapp_number | strip | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')' | remove: '.'
  assign has_details = false
  if settings.contact_email != blank or settings.contact_phone != blank or settings.contact_address != blank or settings.contact_hours != blank
    assign has_details = true
  endif
  assign aside_count = 0
  for block in section.blocks
    case block.type
      when 'whatsapp'
        if wa_digits != blank
          assign aside_count = aside_count | plus: 1
        endif
      when 'details'
        if has_details
          assign aside_count = aside_count | plus: 1
        endif
      else
        assign aside_count = aside_count | plus: 1
    endcase
  endfor
  assign form_id = 'ContactForm-' | append: section.id
  assign title_id = 'ContactTitle-' | append: section.id
  assign title_dot = true
  assign title_last = ss.heading | strip | slice: -1
  if title_last == '.' or title_last == '?' or title_last == '!' or title_last == ':' or title_last == '…'
    assign title_dot = false
  endif
-%}

<div class="section contact scheme-{{ ss.scheme }}" style="--pad-top: {{ ss.padding_top }}px; --pad-bottom: {{ ss.padding_bottom }}px;">
  <div class="page-width">
    <div class="contact__grid{% if aside_count > 0 %} contact__grid--aside{% endif %}">
      <div class="contact__card">
        {%- form 'contact', id: form_id, class: 'contact__form' -%}
          {%- if form.posted_successfully? -%}
            <div class="contact__success" role="status">
              <span class="pg-beacon contact__success-icon">{% render 'icon', name: 'check' %}</span>
              <h2 class="contact__title">{{ 'contact.form.success_title' | t }}</h2>
              <p class="contact__intro">{{ 'contact.form.success_text' | t }}</p>
              <a class="btn btn--brand btn--lg" href="{{ routes.all_products_collection_url }}">{{ 'contact.form.success_cta' | t }}{% render 'icon', name: 'arrow-right' %}</a>
            </div>
          {%- else -%}
            {%- if ss.heading != blank -%}
              <h2 class="contact__title{% if title_dot %} heading-dot{% endif %}" id="{{ title_id }}">{{ ss.heading | escape }}</h2>
            {%- endif -%}
            {%- if ss.text != blank -%}
              <div class="contact__intro">{{ ss.text }}</div>
            {%- endif -%}

            {%- if form.errors -%}
              <div class="form-message form-message--error contact__errors" role="alert">
                <div>
                  <p>{{ 'contact.form.error_heading' | t }}</p>
                  <ul>
                    {%- for field in form.errors -%}
                      <li>
                        {%- if field == 'form' -%}
                          {{ form.errors.messages[field] }}
                        {%- else -%}
                          <a href="#{{ form_id }}-{{ field }}">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</a>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              </div>
            {%- endif -%}

            <div class="contact__fields">
              <div class="field">
                <label class="field__label" for="{{ form_id }}-name">{{ 'contact.form.name' | t }} <span class="contact__opt">({{ 'contact.form.optional' | t }})</span></label>
                <input class="input" type="text" id="{{ form_id }}-name" name="contact[{{ 'contact.form.name' | t }}]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" autocomplete="name"{% if form.errors contains 'name' %} aria-invalid="true"{% endif %}>
              </div>
              {%- if ss.show_phone -%}
                <div class="field">
                  <label class="field__label" for="{{ form_id }}-phone">{{ 'contact.form.phone' | t }} <span class="contact__opt">({{ 'contact.form.optional' | t }})</span></label>
                  <input class="input" type="tel" id="{{ form_id }}-phone" name="contact[{{ 'contact.form.phone' | t }}]" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" autocomplete="tel" inputmode="tel">
                </div>
              {%- endif -%}
              <div class="field contact__full">
                <label class="field__label" for="{{ form_id }}-email">{{ 'contact.form.email' | t }} <span class="contact__req" aria-hidden="true">*</span></label>
                <input class="input" type="email" id="{{ form_id }}-email" name="contact[email]" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" autocomplete="email" autocapitalize="off" spellcheck="false" required aria-required="true"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
              </div>
              <div class="field contact__full">
                <label class="field__label" for="{{ form_id }}-body">{{ 'contact.form.message' | t }} <span class="contact__req" aria-hidden="true">*</span></label>
                <textarea class="textarea" id="{{ form_id }}-body" name="contact[body]" rows="6" placeholder="{{ 'contact.form.message_placeholder' | t }}" required aria-required="true"{% if form.errors contains 'body' %} aria-invalid="true"{% endif %}>{{ form.body }}</textarea>
              </div>
            </div>
            <button type="submit" class="btn btn--primary btn--lg contact__submit">
              {{- 'contact.form.send' | t -}}
              {%- render 'icon', name: 'arrow-right' -%}
            </button>
          {%- endif -%}
        {%- endform -%}
      </div>

      {%- if aside_count > 0 -%}
        <div class="contact__aside">
          {%- if ss.aside_heading != blank -%}
            <h2 class="contact__aside-title">{{ ss.aside_heading | escape }}</h2>
          {%- endif -%}
          {%- for block in section.blocks -%}
            {%- assign bs = block.settings -%}
            {%- case block.type -%}
              {%- when 'whatsapp' -%}
                {%- if wa_digits != blank -%}
                  <div class="contact__block" {{ block.shopify_attributes }}>
                    {%- render 'whatsapp-button', style: 'card', label: bs.title, text: bs.text -%}
                  </div>
                {%- endif -%}
              {%- when 'details' -%}
                {%- if has_details -%}
                  <div class="contact__block contact__details" {{ block.shopify_attributes }}>
                    {%- if bs.heading != blank -%}
                      <h3 class="contact__block-title">{{ bs.heading | escape }}</h3>
                    {%- endif -%}
                    <ul class="contact__list" role="list">
                      {%- if settings.contact_phone != blank -%}
                        {%- assign tel = settings.contact_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.' -%}
                        <li>{% render 'icon', name: 'phone' %}<span><span class="contact__label">{{ 'contact.details.phone' | t }}</span><a href="tel:{{ tel | escape }}">{{ settings.contact_phone | escape }}</a></span></li>
                      {%- endif -%}
                      {%- if settings.contact_email != blank -%}
                        <li>{% render 'icon', name: 'mail' %}<span><span class="contact__label">{{ 'contact.details.email' | t }}</span><a href="mailto:{{ settings.contact_email | strip | escape }}">{{ settings.contact_email | escape }}</a></span></li>
                      {%- endif -%}
                      {%- if settings.contact_address != blank -%}
                        <li>{% render 'icon', name: 'map-pin' %}<span><span class="contact__label">{{ 'contact.details.address' | t }}</span>{{ settings.contact_address | escape }}</span></li>
                      {%- endif -%}
                      {%- if settings.contact_hours != blank -%}
                        <li>{% render 'icon', name: 'clock' %}<span><span class="contact__label">{{ 'contact.details.hours' | t }}</span>{{ settings.contact_hours | escape }}</span></li>
                      {%- endif -%}
                    </ul>
                  </div>
                {%- endif -%}
              {%- when 'highlight' -%}
                <div class="contact__block contact__highlight" {{ block.shopify_attributes }}>
                  <span class="pg-beacon">{% render 'icon', name: bs.icon %}</span>
                  <div>
                    {%- if bs.title != blank -%}<p class="contact__hl-title">{{ bs.title | escape }}</p>{%- endif -%}
                    {%- if bs.text != blank -%}<p class="contact__hl-text">{{ bs.text | escape }}</p>{%- endif -%}
                  </div>
                </div>
              {%- when 'text' -%}
                <div class="contact__block contact__text" {{ block.shopify_attributes }}>
                  {%- if bs.heading != blank -%}<h3 class="contact__block-title">{{ bs.heading | escape }}</h3>{%- endif -%}
                  <div class="rte">{{ bs.text }}</div>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Formulario de contacto",
  "class": "contact-section",
  "settings": [
    {"type": "select", "id": "scheme", "label": "Esquema de color", "options": [{"value": "light", "label": "Claro"}, {"value": "soft", "label": "Gris suave"}, {"value": "brand", "label": "Amarillo"}, {"value": "dark", "label": "Oscuro"}], "default": "light"},
    {"type": "text", "id": "heading", "label": "Título", "default": "Escríbenos"},
    {"type": "richtext", "id": "text", "label": "Texto", "default": "<p>¿Tienes una consulta sobre un producto, un pedido o una medida? Déjanos tu mensaje y te respondemos por correo.</p>"},
    {"type": "checkbox", "id": "show_phone", "label": "Pedir teléfono (opcional)", "default": true},
    {"type": "text", "id": "aside_heading", "label": "Título de la columna lateral", "default": "Datos útiles"},
    {"type": "header", "content": "Espaciado"},
    {"type": "range", "id": "padding_top", "label": "Margen superior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40},
    {"type": "range", "id": "padding_bottom", "label": "Margen inferior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72}
  ],
  "blocks": [
    {
      "type": "whatsapp",
      "name": "WhatsApp",
      "limit": 1,
      "settings": [
        {"type": "paragraph", "content": "Solo aparece si hay un número de WhatsApp en Configuración del tema › Contacto."},
        {"type": "text", "id": "title", "label": "Título", "default": "Escríbenos por WhatsApp"},
        {"type": "text", "id": "text", "label": "Texto", "default": "Si no sabes cuál es, escríbenos con una foto."}
      ]
    },
    {
      "type": "details",
      "name": "Datos de contacto",
      "limit": 1,
      "settings": [
        {"type": "paragraph", "content": "Muestra el teléfono, correo, dirección y horario que completes en Configuración del tema › Contacto. Si están vacíos, el bloque no aparece."},
        {"type": "text", "id": "heading", "label": "Título", "default": "Contacto directo"}
      ]
    },
    {
      "type": "highlight",
      "name": "Dato destacado",
      "settings": [
        {"type": "select", "id": "icon", "label": "Ícono", "options": [{"value": "truck", "label": "Camión"}, {"value": "return", "label": "Cambios"}, {"value": "medal", "label": "Medalla"}, {"value": "shield", "label": "Escudo"}, {"value": "clock", "label": "Reloj"}, {"value": "store", "label": "Tienda"}, {"value": "map-pin", "label": "Ubicación"}, {"value": "wrench", "label": "Herramienta"}, {"value": "bike", "label": "Bicicleta"}, {"value": "card", "label": "Tarjeta"}, {"value": "info", "label": "Información"}], "default": "truck"},
        {"type": "text", "id": "title", "label": "Título", "default": "Envíos a todo el Perú"},
        {"type": "text", "id": "text", "label": "Texto", "default": "Gratis desde S/ 220"}
      ]
    },
    {
      "type": "text",
      "name": "Texto",
      "settings": [
        {"type": "text", "id": "heading", "label": "Título", "default": "Más información"},
        {"type": "richtext", "id": "text", "label": "Texto", "default": "<p>Agrega aquí información adicional para tus clientes.</p>"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Formulario de contacto",
      "blocks": [
        {"type": "whatsapp"},
        {"type": "details"},
        {"type": "highlight", "settings": {"icon": "truck", "title": "Envíos a todo el Perú", "text": "Gratis desde S/ 220"}},
        {"type": "highlight", "settings": {"icon": "return", "title": "Cambios y garantía", "text": "7 días para cambiar, sin abrir"}},
        {"type": "highlight", "settings": {"icon": "medal", "title": "Productos originales", "text": "Vendedor autorizado Rockbros"}}
      ]
    }
  ]
}
{% endschema %}
