{%- comment -%}
  1–3 promo cards (styles: assets/section-home-2.css). Grid: 1 col mobile, 2 ≥750, 3 ≥990
  when there are 3 blocks. Each card has its own scheme and a "mi" watermark.
  image_style: "cover" = photo fills the card under a dark scrim (text turns white);
               "contain-right" = photo cropped in a big circle bleeding off the right edge.
  No image → big typographic card. The button's stretched hit area makes the whole card clickable.
{%- endcomment -%}
{{ 'section-home-2.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign count = section.blocks.size
  assign title_id = 'PromoTitle-' | append: section.id
  assign promo_tag = 'h2'
  if section.settings.heading != blank
    assign promo_tag = 'h3'
  endif
-%}

{%- if count > 0 -%}
  <section class="promos section scheme-{{ section.settings.scheme }}" style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;"{% if section.settings.heading != blank %} aria-labelledby="{{ title_id }}"{% endif %}>
    <div class="page-width">
      {%- render 'section-heading', title: section.settings.heading, id: title_id -%}
      <div class="promos__grid promos__grid--{{ count }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign img = b.image
            assign card_scheme = b.scheme
            assign style = b.image_style
            if img != blank and style == 'cover'
              assign card_scheme = 'dark'
            endif
            assign wm_tone = 'mono-dark'
            if card_scheme == 'dark'
              assign wm_tone = 'mono-light'
            endif
            assign h_last = b.heading | strip | slice: -1
            assign h_dot = true
            if h_last == '.' or h_last == '?' or h_last == '!' or h_last == ':' or h_last == '…'
              assign h_dot = false
            endif
            assign img_sizes = '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw'
            if style == 'contain-right'
              # Circle = square crop (object-fit: cover): a landscape photo needs its aspect
              # ratio × the circle's width to stay sharp.
              assign crop = img.aspect_ratio | default: 1 | at_least: 1
              assign vw_d = crop | times: 30 | ceil
              assign vw_m = crop | times: 70 | ceil
              assign img_sizes = '(min-width: 750px) ' | append: vw_d | append: 'vw, ' | append: vw_m | append: 'vw'
            endif
          -%}
          <article class="promo scheme-{{ card_scheme }} has-watermark{% if img != blank %} promo--image promo--{{ style }}{% else %} promo--type{% endif %}" data-reveal style="--reveal-delay: {{ forloop.index0 | times: 90 }}ms;" {{ block.shopify_attributes }}>
            {%- if img != blank -%}
              <div class="promo__media">
                {%- render 'image', image: img, widths: '360,540,720,900,1080,1296,1600', sizes: img_sizes, lazy: true, alt: '', class: 'promo__img' -%}
              </div>
            {%- endif -%}

            {%- if b.icon != 'none' and b.icon != blank -%}
              <span class="promo__badge" aria-hidden="true">{% render 'icon', name: b.icon %}</span>
            {%- endif -%}

            <div class="promo__content">
              {%- if b.eyebrow != blank -%}
                <p class="eyebrow eyebrow--dot promo__eyebrow">{{ b.eyebrow | escape }}</p>
              {%- endif -%}
              {%- if b.heading != blank -%}
                <{{ promo_tag }} class="promo__heading{% if h_dot %} heading-dot{% endif %}">{{ b.heading | escape }}</{{ promo_tag }}>
              {%- endif -%}
              {%- if b.text != blank -%}
                <p class="promo__text">{{ b.text | escape | replace: 'S/ ', 'S/ ' }}</p>
              {%- endif -%}
              {%- if b.button_label != blank and b.button_link != blank -%}
                <a class="btn btn--primary promo__btn" href="{{ b.button_link }}">
                  {{- b.button_label | escape -}}
                  {%- render 'icon', name: 'arrow-right' -%}
                </a>
              {%- endif -%}
            </div>

            {%- unless img != blank and style == 'cover' -%}
              {%- render 'logo', variant: 'mark', tone: wm_tone, label: '', class: 'mi-watermark promo__watermark' -%}
            {%- endunless -%}
          </article>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Banners promocionales",
  "tag": "div",
  "class": "promos-section",
  "max_blocks": 3,
  "settings": [
    {"type": "select", "id": "scheme", "label": "Fondo de la sección", "options": [{"value": "light", "label": "Claro"}, {"value": "soft", "label": "Gris suave"}, {"value": "brand", "label": "Amarillo"}, {"value": "dark", "label": "Oscuro"}], "default": "light"},
    {"type": "text", "id": "heading", "label": "Título (opcional)"},
    {"type": "header", "content": "Espaciado"},
    {"type": "range", "id": "padding_top", "label": "Margen superior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24},
    {"type": "range", "id": "padding_bottom", "label": "Margen inferior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56}
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {"type": "select", "id": "scheme", "label": "Color", "info": "Con imagen en «Fondo completo» la tarjeta usa texto blanco sobre la foto y este color no se aplica.", "options": [{"value": "brand", "label": "Amarillo"}, {"value": "dark", "label": "Negro"}, {"value": "light", "label": "Blanco"}, {"value": "soft", "label": "Gris suave"}], "default": "brand"},
        {"type": "image_picker", "id": "image", "label": "Imagen (opcional)", "info": "Sin imagen: tarjeta tipográfica con la marca «mi» de fondo."},
        {"type": "select", "id": "image_style", "label": "Estilo de imagen", "options": [{"value": "contain-right", "label": "Círculo a la derecha"}, {"value": "cover", "label": "Fondo completo"}], "default": "contain-right"},
        {"type": "select", "id": "icon", "label": "Sello con ícono", "options": [{"value": "none", "label": "Ninguno"}, {"value": "medal", "label": "Medalla"}, {"value": "shield", "label": "Escudo"}, {"value": "truck", "label": "Camión"}, {"value": "light", "label": "Luz"}, {"value": "mirror", "label": "Espejo"}, {"value": "helmet", "label": "Casco"}, {"value": "tire", "label": "Llanta"}, {"value": "bolt", "label": "Rayo"}, {"value": "tag", "label": "Etiqueta"}], "default": "none"},
        {"type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Para tu manubrio"},
        {"type": "text", "id": "heading", "label": "Título", "default": "Mira atrás sin girar el cuerpo"},
        {"type": "text", "id": "text", "label": "Texto", "default": "Espejos para bici y scooter."},
        {"type": "text", "id": "button_label", "label": "Botón", "default": "Ver espejos"},
        {"type": "url", "id": "button_link", "label": "Enlace"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Banners promocionales",
      "blocks": [
        {"type": "banner", "settings": {"scheme": "dark", "icon": "medal", "eyebrow": "Vendedor autorizado", "heading": "Rockbros original", "text": "Luces, pedales y accesorios con respaldo de marca.", "button_label": "Ver Rockbros"}},
        {"type": "banner"}
      ]
    }
  ],
  "disabled_on": {"groups": ["header", "footer"]}
}
{% endschema %}
