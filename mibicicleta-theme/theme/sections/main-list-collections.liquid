{%- comment -%}
  /collections: grid of collection cards (image, or the category icon on yellow with a red dot),
  title, product count. Blocks "collection" pick and order the cards; without blocks every
  collection is listed (sorted by the "sort" setting), skipping the internal "frontpage".
{%- endcomment -%}
{{ 'section-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ps = section.settings
  assign icon_map = 'luces:light,luz:light,linterna:light,llanta:tire,camara:tire,pinon:gear,transmision:gear,cadena:gear,espejo:mirror,asiento:seat,sillin:seat,pedal:pedal,grip:grip,puno:grip,tapabarro:mudguard,casco:helmet,proteccion:helmet,lente:glasses,scooter:scooter,rockbros:medal,neco:medal,accesorio:bag,componente:wrench,herramienta:wrench,destacado:star,oferta:tag' | split: ','
  assign list = collections
  case ps.sort
    when 'products_high', 'products_low'
      assign list = collections | sort: 'all_products_count'
    when 'date', 'date_reversed'
      assign list = collections | sort: 'published_at'
  endcase
  if ps.sort == 'products_high' or ps.sort == 'date_reversed'
    assign list = list | reverse
  endif
  case ps.ratio
    when 'square'
      assign ratio = 1
    when 'portrait'
      assign ratio = 0.8
    else
      assign ratio = 1.33
  endcase
-%}

<div class="section list-collections scheme-{{ ps.scheme }}" style="--pad-top: {{ ps.padding_top }}px; --pad-bottom: {{ ps.padding_bottom }}px;">
  <div class="page-width">
    {%- render 'breadcrumbs', class: 'list-collections__crumbs' -%}
    <div class="list-collections__head">
      <h1 class="list-collections__title heading-dot">{{ ps.heading | escape }}</h1>
      {%- if ps.text != blank -%}
        <p class="list-collections__text">{{ ps.text | escape }}</p>
      {%- endif -%}
    </div>

    <ul class="collection-grid collection-grid--{{ ps.columns_desktop }}" role="list" style="--ratio: {{ ratio }};">
      {%- liquid
        assign rendered = 0
        if section.blocks.size > 0
          assign source = section.blocks
        else
          assign source = list
        endif
      -%}
      {%- for entry in source -%}
        {%- liquid
          if section.blocks.size > 0
            assign c = entry.settings.collection
          else
            assign c = entry
          endif
          if c == blank or c.handle == 'frontpage'
            continue
          endif
          assign rendered = rendered | plus: 1
          assign icon_name = 'bike'
          for pair in icon_map
            assign kv = pair | split: ':'
            if c.handle contains kv[0]
              assign icon_name = kv[1]
              break
            endif
          endfor
          assign card_lazy = true
          if rendered <= 4
            assign card_lazy = false
          endif
        -%}
        <li class="collection-card__item" data-reveal{% if section.blocks.size > 0 %} {{ entry.shopify_attributes }}{% endif %}>
          <a class="collection-card" href="{{ c.url }}">
            <span class="collection-card__media{% if c.image == blank %} collection-card__media--icon{% endif %}">
              {%- if c.image != blank -%}
                {%- render 'image', image: c.image, widths: '240,360,480,640,800', sizes: '(min-width: 1200px) 300px, (min-width: 750px) 30vw, 50vw', lazy: card_lazy, alt: '' -%}
              {%- else -%}
                <span class="collection-card__icon beacon">{% render 'icon', name: icon_name %}</span>
              {%- endif -%}
            </span>
            <span class="collection-card__body">
              <span class="collection-card__title">{{ c.title | escape }}</span>
              {%- if ps.show_count -%}
                <span class="collection-card__count">{{ 'collections.product_count' | t: count: c.all_products_count }}</span>
              {%- endif -%}
            </span>
            <span class="collection-card__arrow" aria-hidden="true">{% render 'icon', name: 'arrow-right' %}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
    {%- if rendered == 0 -%}
      <p class="list-collections__empty">{{ 'collections.list.empty' | t }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Lista de colecciones",
  "class": "list-collections-section",
  "settings": [
    {"type": "select", "id": "scheme", "label": "Esquema de color", "options": [{"value": "light", "label": "Claro"}, {"value": "soft", "label": "Gris suave"}, {"value": "brand", "label": "Amarillo"}, {"value": "dark", "label": "Oscuro"}], "default": "light"},
    {"type": "text", "id": "heading", "label": "Título", "default": "Categorías"},
    {"type": "text", "id": "text", "label": "Texto", "default": "Accesorios y repuestos para tu bici o scooter, ordenados por categoría."},
    {"type": "select", "id": "sort", "label": "Orden", "info": "Se aplica cuando no eliges colecciones con bloques.", "options": [{"value": "alphabetical", "label": "Alfabético"}, {"value": "products_high", "label": "Más productos primero"}, {"value": "products_low", "label": "Menos productos primero"}, {"value": "date", "label": "Más antiguas primero"}, {"value": "date_reversed", "label": "Más nuevas primero"}], "default": "alphabetical"},
    {"type": "select", "id": "ratio", "label": "Formato de imagen", "options": [{"value": "landscape", "label": "Horizontal"}, {"value": "square", "label": "Cuadrado"}, {"value": "portrait", "label": "Vertical"}], "default": "landscape"},
    {"type": "select", "id": "columns_desktop", "label": "Columnas en escritorio", "options": [{"value": "3", "label": "3"}, {"value": "4", "label": "4"}], "default": "4"},
    {"type": "checkbox", "id": "show_count", "label": "Mostrar cantidad de productos", "default": true},
    {"type": "header", "content": "Espaciado"},
    {"type": "range", "id": "padding_top", "label": "Margen superior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24},
    {"type": "range", "id": "padding_bottom", "label": "Margen inferior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64}
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Colección",
      "settings": [
        {"type": "collection", "id": "collection", "label": "Colección"}
      ]
    }
  ]
}
{% endschema %}
