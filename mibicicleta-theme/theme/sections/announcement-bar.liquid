{%- comment -%}
  Announcement bar (header group, black by default).
  mode "marquee": a seamless ticker. The list is rendered twice (the copy is aria-hidden and
  untabbable); announcement-bar.js adds more copies when one copy is narrower than the screen. It pauses
  on hover/focus and with the pause button, and becomes a static, swipeable row under
  prefers-reduced-motion.
  mode "rotate": one message at a time with prev/next; any interaction stops the rotation.
  Blocks "message": text, optional link, optional discount code (copied on click).
  [envio_gratis] in a message becomes the free-shipping amount of Theme settings › Carrito.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  {{ 'section-announcement.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'announcement-bar.js' | asset_url }}" defer></script>

  {%- liquid
    assign mode = section.settings.mode | default: 'marquee'
    assign copies = 1
    if mode == 'marquee'
      assign copies = 2
    endif
    assign copied_label = 'general.copied' | t
    assign fs_amount = settings.free_shipping_threshold | times: 100 | money_without_trailing_zeros
  -%}

  <div class="announcement scheme-{{ section.settings.scheme | default: 'dark' }}{% if section.settings.show_dots %} announcement--dots{% endif %}">
    <announcement-bar
      class="announcement__inner announcement--{{ mode }}"
      data-mode="{{ mode }}"
      data-interval="{{ section.settings.rotate_seconds }}"
      role="region"
      aria-label="{{ 'header.announcement.label' | t }}"
      style="--marquee-duration: {{ section.settings.speed }}s;"
    >
      {%- if mode == 'rotate' and section.blocks.size > 1 -%}
        <button type="button" class="announcement__arrow js-only" data-announcement-prev aria-label="{{ 'header.announcement.previous' | t }}">
          {%- render 'icon', name: 'chevron-left' -%}
        </button>
      {%- endif -%}

      <div class="announcement__viewport">
        <div class="announcement__track" data-track>
          {%- for copy in (1..copies) -%}
            <ul class="announcement__list" role="list" data-list{% if copy > 1 %} aria-hidden="true" data-clone{% endif %}>
              {%- for block in section.blocks -%}
                {%- liquid
                  assign code = block.settings.code | strip
                  assign text = block.settings.text | escape
                  if text contains '[envio_gratis]'
                    if settings.free_shipping_threshold <= 0
                      continue
                    endif
                    assign text = text | replace: '[envio_gratis]', fs_amount
                  endif
                  assign tab = ''
                  if copy > 1
                    assign tab = ' tabindex="-1"'
                  endif
                -%}
                <li class="announcement__item" {% if copy == 1 %}{{ block.shopify_attributes }}{% endif %} data-index="{{ forloop.index0 }}">
                  {%- if block.settings.link != blank -%}
                    <a class="announcement__text announcement__link" href="{{ block.settings.link }}"{{ tab }}>
                      {{- text -}}
                    </a>
                  {%- else -%}
                    <span class="announcement__text">{{ text }}</span>
                  {%- endif -%}
                  {%- if code != blank -%}
                    <button type="button" class="announcement__code" data-copy-code="{{ code | escape }}" aria-label="{{ 'header.announcement.copy_code' | t: code: code }}"{{ tab }}>
                      <span class="announcement__code-text">
                        <span data-code>{{ code | escape }}</span>
                        <span data-copied aria-hidden="true">{{ copied_label }}</span>
                      </span>
                      {%- render 'icon', name: 'copy' -%}
                    </button>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          {%- endfor -%}
        </div>
      </div>

      {%- if mode == 'rotate' and section.blocks.size > 1 -%}
        <button type="button" class="announcement__arrow js-only" data-announcement-next aria-label="{{ 'header.announcement.next' | t }}">
          {%- render 'icon', name: 'chevron-right' -%}
        </button>
      {%- elsif mode == 'marquee' -%}
        <button type="button" class="announcement__pause js-only" data-announcement-pause aria-pressed="false" aria-label="{{ 'header.announcement.pause' | t }}">
          {%- render 'icon', name: 'pause' -%}
          {%- render 'icon', name: 'play' -%}
        </button>
      {%- endif -%}
    </announcement-bar>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncios",
  "class": "announcement-section",
  "enabled_on": { "groups": ["header"] },
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Esquema de color",
      "options": [
        { "value": "light", "label": "Claro" },
        { "value": "soft", "label": "Gris suave" },
        { "value": "brand", "label": "Amarillo" },
        { "value": "dark", "label": "Oscuro" }
      ],
      "default": "dark"
    },
    {
      "type": "select",
      "id": "mode",
      "label": "Movimiento",
      "options": [
        { "value": "marquee", "label": "Cinta continua" },
        { "value": "rotate", "label": "Un mensaje a la vez" }
      ],
      "default": "marquee",
      "info": "Con «reducir movimiento» activado en el dispositivo, los mensajes se muestran quietos."
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Duración de cada vuelta (cinta)",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 40,
      "visible_if": "{{ section.settings.mode == 'marquee' }}"
    },
    {
      "type": "range",
      "id": "rotate_seconds",
      "label": "Tiempo por mensaje (uno a la vez)",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5,
      "visible_if": "{{ section.settings.mode == 'rotate' }}"
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Separar mensajes con punto rojo",
      "default": true,
      "visible_if": "{{ section.settings.mode == 'marquee' }}"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Mensaje",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Envío gratis a todo el Perú desde [envio_gratis]",
          "info": "Escribe [envio_gratis] para mostrar el monto de Configuración del tema › Carrito: se actualiza solo. Si el monto es 0, ese mensaje no se muestra."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace (opcional)"
        },
        {
          "type": "text",
          "id": "code",
          "label": "Código de descuento (opcional)",
          "info": "Se muestra como etiqueta y se copia al tocarla. Usa solo códigos que existan en Descuentos."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra de anuncios",
      "blocks": [{ "type": "message" }]
    }
  ]
}
{% endschema %}
